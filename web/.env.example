# CloseProof Frontend Environment Configuration

# WebSocket URL for live telemetry stream (Contract E: ws://<host>/api/telemetry)
# If unset, CloseRoom defaults to deterministic replay mode
NEXT_PUBLIC_WS_URL=

# Base URL for metadata and canonical links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Backend API base URL for packet exports (e.g. http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
